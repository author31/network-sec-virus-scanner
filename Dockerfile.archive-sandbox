# Single-use archive scan sandbox image.
#
# Launched by `docker_sandbox.run_sandbox(...)` — one container per archive
# layer. The container is started with --network=none, a read-only root,
# dropped capabilities and resource caps; this image only provides the
# unpacker binaries and a copy of the sentinel package.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        unzip \
        tar \
        gzip \
        bzip2 \
        xz-utils \
        p7zip-full \
        unrar-free \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/sentinel

COPY pyproject.toml ./
COPY src ./src
COPY scripts/sandbox_entrypoint.py ./scripts/sandbox_entrypoint.py

RUN pip install --no-cache-dir .

RUN install -d -o 65534 -g 65534 /work /out

USER 65534:65534

ENTRYPOINT ["python", "/opt/sentinel/scripts/sandbox_entrypoint.py"]
